# Database
DATABASE_URL="postgresql://goyal:goyal_dev_password@localhost:5433/goyal_eoi?schema=public"
DIRECT_URL="postgresql://goyal:goyal_dev_password@localhost:5433/goyal_eoi?schema=public"
# Auth
AUTH_SECRET="generate-a-secure-random-string-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AWS S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="goyal-eoi-documents"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# Email (Brevo) — required for customer confirmation emails on EOI / Lead punch
# Without a real key, emails run in mock mode (logged to console only). Restart the server after changing this.
BREVO_API_KEY=""
EMAIL_FROM="noreply@goyalprojects.com"
EMAIL_FROM_NAME="Goyal & Co. | Hariyana Group"

# Redis
REDIS_URL="redis://localhost:6379"

# Integration providers (mock | nsdl | msg91 | salesforce | goyal)
KYC_PROVIDER="mock"
SMS_PROVIDER="mock"
# Use "goyal" (or set EOI_API_KEY) to punch leads/EOIs into Goyal Hariyana CRM
CRM_PROVIDER="goyal"

# Goyal Hariyana CRM — EOI webhook (see EOI_WEBSITE_INTEGRATION.txt / EOI_LEADS_API.txt)
# POST https://goyalhariyanacrm.in/api/webhooks/eoi
GOYAL_CRM_API_URL="https://goyalhariyanacrm.in/api"
EOI_API_KEY=""

# Reception webhook for site-visit completed + booking confirmed
# Must match Booking_Inventory INTEGRATION_WEBHOOK_SECRET
INTEGRATION_WEBHOOK_SECRET="change-me-integration-webhook-secret"

# Encryption key for PII (32+ chars; required in production)
PII_ENCRYPTION_KEY="generate-a-32-byte-key-for-pii-fields"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
