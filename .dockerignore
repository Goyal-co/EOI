# Dependencies & build output (image installs on Alpine)
node_modules
**/node_modules
.next
**/.next
.turbo
**/coverage
**/*.tsbuildinfo

# VCS / editor / CI (not needed in the image)
.git
.github
.cursor
.vscode
.idea

# Secrets — never bake these (paths relative to context; ** required for nested files)
.env
.env.*
**/.env
**/.env.*
!**/.env.production.example
apps/web/.env.local
apps/web/.env.production

# Deploy sidecar files
infra
e2e
e2e-results
playwright-report
apps/web/e2e
apps/web/test-results
apps/web/playwright-report

# Noise
**/*.md
**/*.test.ts
**/*.test.tsx
docker-compose*.yml
